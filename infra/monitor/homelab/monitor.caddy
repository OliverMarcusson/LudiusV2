# BEGIN ludius-monitor
# Remove with infra/monitor/homelab/remove-monitor.sh (it needs the BEGIN and END lines exactly as they are).
# Public site: Claustra login, then the loopback hop below. Claustra sees the real Host (monitor.ludius.se).
monitor.ludius.se {
	import claustra_forward http://127.0.0.1:18452
}

# Loopback-only hop. The agent only answers Host 127.0.0.1:7452 (RequireHost and AllowedHosts), and the snippet
# can't set header_up, so the Host rewrite lives here. Origin passes through unchanged (https://monitor.ludius.se),
# which the agent's allowed-origin setting accepts. WebSocket upgrades are proxied by Caddy without extra config.
http://127.0.0.1:18452 {
	bind 127.0.0.1
	reverse_proxy __BOX_TAILNET_IP__:__TS_PORT__ {
		header_up Host 127.0.0.1:7452
	}
}
# END ludius-monitor
