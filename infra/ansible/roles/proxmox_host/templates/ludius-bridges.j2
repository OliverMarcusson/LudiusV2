auto {{ range_bridge }}
iface {{ range_bridge }} inet static
    address {{ range_net }}.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    # mangle runs before filter, where Tailscale puts its own accepts first (tasks/range-bridge-isolated.yml)
    post-up for t in iptables ip6tables; do for d in -i -o; do $t -t mangle -C FORWARD $d {{ range_bridge }} -j DROP 2>/dev/null || $t -t mangle -I FORWARD $d {{ range_bridge }} -j DROP; done; done
    pre-down for t in iptables ip6tables; do for d in -i -o; do $t -t mangle -D FORWARD $d {{ range_bridge }} -j DROP 2>/dev/null || true; done; done

auto {{ build_bridge }}
iface {{ build_bridge }} inet static
    address 10.78.0.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    post-up echo 1 > /proc/sys/net/ipv4/ip_forward
    post-up iptables -t nat -A POSTROUTING -s 10.78.0.0/24 -o {{ ansible_default_ipv4.interface }} -j MASQUERADE
    pre-down iptables -t nat -D POSTROUTING -s 10.78.0.0/24 -o {{ ansible_default_ipv4.interface }} -j MASQUERADE
