map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# The client certificate's CN is the account (one certificate per person from chat01's own CA, no AD).
map $ssl_client_s_dn $client_cn {
    default "";
    "~(^|,)CN=(?<cn>[a-z][a-z0-9._-]*)(,|$)" $cn;
}

server {
    listen 80 default_server;
    server_name {{ chat_host }};
    return 301 https://{{ chat_host }}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name {{ chat_host }};
    ssl_certificate /etc/ludius-chat/pki/server.crt;
    ssl_certificate_key /etc/ludius-chat/pki/server.key;
    ssl_client_certificate /etc/ludius-chat/pki/ca.crt;
    ssl_verify_client optional;
    client_max_body_size 50M;

    location = /oauth/authorize {
        if ($ssl_client_verify != SUCCESS) {
            return 401;
        }
        proxy_set_header X-Remote-User $client_cn;
        proxy_pass http://127.0.0.1:8070;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Remote-User "";
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_pass http://127.0.0.1:8065;
    }
}
