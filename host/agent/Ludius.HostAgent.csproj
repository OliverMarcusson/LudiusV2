<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0-windows: Hyper-V (test). net10.0: Linux, the Proxmox backend (production), one agent per node. -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ludius.HostAgent</RootNamespace>
    <AssemblyName>ludius-host-agent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\ludius\v1\observation.proto" ProtoRoot="..\..\proto" GrpcServices="None" />
    <Protobuf Include="..\..\proto\ludius\v1\agent.proto" ProtoRoot="..\..\proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="..\..\guest\observer\HyperVEndPoint.cs" Link="HyperVEndPoint.cs" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="HyperV.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ludius.HostAgent.Tests" />
  </ItemGroup>

</Project>
