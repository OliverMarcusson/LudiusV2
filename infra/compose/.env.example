# Copy to .env (git-ignored) and fill in. Use URL-safe passwords (letters/digits): they go into a postgresql:// DSN.
# `docker compose` refuses to start while either password is empty.
TEMPORAL_DB_PASSWORD=
LUDIUS_DB_PASSWORD=

# Optional host ports (loopback only).
# LUDIUS_PG_PORT=5432
# LUDIUS_TEMPORAL_PORT=7233

# Controller side (shell env of the Windows host, not read by compose):
#   LUDIUS_PG=postgresql://ludius:<LUDIUS_DB_PASSWORD>@127.0.0.1:5432/ludius
#   ludius day --temporal 127.0.0.1:7233 ...
#
# Screenshots (optional, `ludius store sync` skips them when LUDIUS_S3 is unset): no MinIO service here.
# MinIO community edition is source-only now (github.com/minio/minio README); Docker Hub has no minio/minio
# repo and quay.io/minio/minio tags could not be listed anonymously, so no image is pinned. Point at any
# S3-compatible server you run yourself:
#   LUDIUS_S3=http://<ACCESS_KEY>:<SECRET_KEY>@<host>:9000/<bucket>
