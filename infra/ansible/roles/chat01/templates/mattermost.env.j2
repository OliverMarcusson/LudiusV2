# Mattermost settings (environment overrides config.json and locks them in the System Console). roles/chat01.
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://mattermost@/mattermost?host=/var/run/postgresql&sslmode=disable
MM_SERVICESETTINGS_SITEURL=http://{{ chat_host }}
MM_SERVICESETTINGS_LISTENADDRESS=127.0.0.1:8065
MM_SERVICESETTINGS_ENABLELOCALMODE=true
MM_SERVICESETTINGS_ALLOWEDUNTRUSTEDINTERNALCONNECTIONS=127.0.0.1
MM_SERVICESETTINGS_ENABLELINKPREVIEWS=false
MM_SERVICESETTINGS_ENABLEDESKTOPLANDINGPAGE=false
MM_SERVICESETTINGS_ENABLETUTORIAL=false
MM_SERVICESETTINGS_ENABLEONBOARDINGFLOW=false
MM_SERVICESETTINGS_ENABLESECURITYFIXALERT=false
MM_TEAMSETTINGS_TEAMMATENAMEDISPLAY=full_name
MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL=false
MM_EMAILSETTINGS_ENABLESIGNINWITHEMAIL=false
MM_EMAILSETTINGS_ENABLESIGNINWITHUSERNAME=false
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=false
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false
MM_GITLABSETTINGS_ENABLE=true
MM_GITLABSETTINGS_ID=ludius-chat
MM_GITLABSETTINGS_SECRET={{ chat_sso_secret }}
MM_GITLABSETTINGS_AUTHENDPOINT=http://{{ chat_host }}/oauth/authorize
MM_GITLABSETTINGS_TOKENENDPOINT=http://127.0.0.1:8070/oauth/token
MM_GITLABSETTINGS_USERAPIENDPOINT=http://127.0.0.1:8070/api/v4/user
MM_LOGSETTINGS_ENABLEDIAGNOSTICS=false
MM_PLUGINSETTINGS_ENABLE=false
MM_PLUGINSETTINGS_ENABLEMARKETPLACE=false
MM_ANNOUNCEMENTSETTINGS_ADMINNOTICESENABLED=false
MM_ANNOUNCEMENTSETTINGS_USERNOTICESENABLED=false
