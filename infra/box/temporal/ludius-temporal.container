[Unit]
Description=Ludius Temporal server (127.0.0.1:7233)
Requires=ludius-temporal-setup.service
After=ludius-temporal-setup.service

[Container]
ContainerName=ludius-temporal
Image=docker.io/temporalio/server:1.32.1@sha256:acecbab5b0b8ae9cf4012b508866ca97feda3709577bf157b537239f40029049
Network=host
EnvironmentFile=/etc/ludius/compose.env
Environment=DB=postgres12
Environment=DB_PORT=5432
Environment=POSTGRES_USER=temporal
Environment=POSTGRES_SEEDS=127.0.0.1
Environment=BIND_ON_IP=127.0.0.1
Volume=/etc/ludius/dynamicconfig/docker.yaml:/etc/temporal/config/dynamicconfig/docker.yaml:ro
HealthCmd=nc -z 127.0.0.1 7233
HealthInterval=5s
HealthTimeout=3s
HealthRetries=30
HealthStartPeriod=20s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
