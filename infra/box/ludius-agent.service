# Host agent on the Proxmox box (installed by infra/box/install.sh). Root: pvesh and the QMP sockets are root-only.
# gRPC and the monitor listen on loopback only; the controller runs on this host, the tailnet reaches the monitor
# through caddy (127.0.0.1:7453, fixes Host) and `tailscale serve` (infra/monitor).
[Unit]
Description=Ludius host agent (Proxmox backend)
After=network.target pve-cluster.service pvedaemon.service
Wants=pve-cluster.service pvedaemon.service

[Service]
WorkingDirectory=/opt/ludius-agent
ExecStart=/opt/ludius-agent/ludius-host-agent
Restart=on-failure
RestartSec=5
# /run/ludius-agent: screendump scratch (Proxmox:ScratchDir default), 0700.
RuntimeDirectory=ludius-agent
RuntimeDirectoryMode=0700
Environment=Agent__Backend=proxmox
Environment=Proxmox__Pool=ludius
Environment=Proxmox__Node=ludius-pve
Environment=Agent__MaxRunningVms=8
# Range servers (DC, Exchange, srv01) live in 110-119 and neither count toward nor are held by the cap
Environment=Proxmox__CapExemptIds=110,111,112,113,114,115,116,117,118,119
# Explicit, so a published appsettings.json (it carries the desktop's host names) cannot widen what answers.
Environment=AllowedHosts=127.0.0.1
Environment=Kestrel__Endpoints__Grpc__Url=http://127.0.0.1:7451
Environment=Kestrel__Endpoints__Monitor__Url=http://127.0.0.1:7452
Environment=Monitor__Root=/opt/ludius-agent/monitor
Environment=Monitor__AllowedOrigins=https://monitor.ludius.se
# The controller writes these under runs/ in the repo checkout on the box.
Environment=Monitor__Calls=/root/src/LudiusV2/runs/openrouter-calls.json
Environment=Monitor__Admission=/root/src/LudiusV2/runs/admission

[Install]
WantedBy=multi-user.target
