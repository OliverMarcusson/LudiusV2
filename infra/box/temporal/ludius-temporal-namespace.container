[Unit]
Description=Ludius Temporal default namespace
Requires=ludius-temporal.service
After=ludius-temporal.service

[Container]
ContainerName=ludius-temporal-namespace
Image=docker.io/temporalio/admin-tools:1.32.1@sha256:9ef0dc5b063bf4ffd5c1512de72e0e73e225bd2c7006a18ce69bd592a8862a83
Network=host
Volume=/etc/ludius/namespace.sh:/namespace.sh:ro
Entrypoint=/bin/sh
Exec=-e /namespace.sh

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
