# One-shot: Temporal's schema in postgres (rerun-safe).
[Unit]
Description=Ludius Temporal schema setup
Requires=ludius-postgres.service
After=ludius-postgres.service

[Container]
ContainerName=ludius-temporal-setup
Image=docker.io/temporalio/admin-tools:1.32.1@sha256:9ef0dc5b063bf4ffd5c1512de72e0e73e225bd2c7006a18ce69bd592a8862a83
Network=host
EnvironmentFile=/etc/ludius/compose.env
Volume=/etc/ludius/setup.sh:/setup.sh:ro
Entrypoint=/bin/sh
Exec=-e /setup.sh

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
